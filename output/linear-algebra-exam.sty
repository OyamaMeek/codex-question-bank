\newcommand{\Question}[4]{%
  \clearpage
  \def\CurrentNumber{#1}%
  \def\CurrentSource{#3}%
  \pdfbookmark[1]{第 #1 题}{q#1}%
  {\small\color{examaccent}#2\hfill #4 分}\par
  {\Large\bfseries 第 #1 题}\par\smallskip
